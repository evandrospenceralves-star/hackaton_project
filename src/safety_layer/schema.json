{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SafetyLayerEvent",
  "description": "Wire format for an early-warning event emitted by the safety layer.",
  "type": "object",
  "required": [
    "camera_id",
    "event_type",
    "fall_score",
    "immobility_score",
    "tracking_confidence",
    "overall_confidence",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "camera_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": ["possible_fall", "possible_distress", "prolonged_immobility"]
    },
    "fall_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "immobility_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "tracking_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "overall_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp with UTC offset, e.g. 2026-09-12T10:22:16-07:00"
    }
  }
}
